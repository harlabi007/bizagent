# Gemini (Google AI Studio) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase - https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio - https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Server
PORT=3000

# Optional but recommended once deployed: your permanent live URL, used
# to build the dashboard auto-login link sent over WhatsApp. Without
# this, the app tries to detect it automatically, which can be wrong
# behind some hosting providers' proxies.
APP_BASE_URL=https://bizagent-yoqj.onrender.com

# Paystack (optional) - only needed for the payments feature to send real
# transfers. Without this, the agent still tracks and drafts payments, it
# just gives the owner the details to send manually instead of sending
# automatically. Get this from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=
